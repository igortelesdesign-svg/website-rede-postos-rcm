import React, { useState, useEffect } from 'react';
import {
  MapPin,
  Fuel,
  Navigation,
  Sparkles,
  ChevronRight,
  ChevronLeft,
  Search,
  MessageCircle,
  Truck,
  Store,
  ShieldCheck,
  Award,
  ArrowRight,
  Clock,
  Wrench,
  CheckCircle2,
  X
} from 'lucide-react';
import { useData } from '../context/DataContext';
import { StationUnit, Product, ServiceItem, NewsItem, ClassifiedItem, ActionItem } from '../types';
import { RcmMascot } from '../components/RcmMascot';
import { StationCard } from '../components/StationCard';
import { GoogleMapEmbed } from '../components/GoogleMapEmbed';
import { ViewTab } from '../components/Navbar';

interface HomeViewProps {
  setActiveTab: (tab: ViewTab) => void;
  onSelectUnit: (station: StationUnit) => void;
  onSelectNews: (news: NewsItem) => void;
}

export const HomeView: React.FC<HomeViewProps> = ({
  setActiveTab,
  onSelectUnit,
  onSelectNews
}) => {
  const { stations, products, services, news, classifieds, actions, transporter } = useData();

  // Search state for "RCM Perto de Você"
  const [searchTerm, setSearchTerm] = useState('');
  const [selectedCity, setSelectedCity] = useState('all');

  // Hero Slider State
  const [currentSlide, setCurrentSlide] = useState(0);
  const [mascotBubbleVisible, setMascotBubbleVisible] = useState(true);

  // Hero Slides based on real station photography provided
  const heroSlides = [
    {
      id: 'slide-joao-camara',
      unitName: 'Posto RCM — João Câmara / RN',
      subtext: 'Unidade ao Entardecer • Padrão 24H na BR-406',
      photo: '/assets/rcm-joao-camara.jpeg',
      tag: 'Entardecer • BR-406'
    },
    {
      id: 'slide-alcantil',
      unitName: 'Posto RCM — Alcantil / PB',
      subtext: 'Operação Noturna Iluminada • Balizadores LED & Totem 24H',
      photo: '/assets/rcm-alcantil.jpeg',
      tag: 'Operação Noturna 24H • BR-104'
    },
    {
      id: 'slide-tacima',
      unitName: 'Posto RCM — Tacima / PB',
      subtext: 'Pista Diurna Moderna • Amplo Pátio de Abastecimento',
      photo: '/assets/rcm-tacima.jpeg',
      tag: 'Estrutura Diurna • PB-111'
    }
  ];

  // Auto-advance hero slides
  useEffect(() => {
    const timer = setInterval(() => {
      setCurrentSlide(prev => (prev + 1) % heroSlides.length);
    }, 6000);
    return () => clearInterval(timer);
  }, [heroSlides.length]);

  // Mascot welcome bubble auto-dismiss after 8 seconds
  useEffect(() => {
    const bubbleTimer = setTimeout(() => {
      setMascotBubbleVisible(false);
    }, 8000);
    return () => clearTimeout(bubbleTimer);
  }, []);

  const cities = Array.from(new Set(stations.map(s => s.cidade || s.city)));

  const filteredStations = stations.filter(st => {
    const name = st.nome || st.name;
    const city = st.cidade || st.city;
    const address = st.endereco || st.address;
    const state = st.estado || st.state;

    const matchesText =
      name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      city.toLowerCase().includes(searchTerm.toLowerCase()) ||
      address.toLowerCase().includes(searchTerm.toLowerCase()) ||
      state.toLowerCase().includes(searchTerm.toLowerCase());

    const matchesCity = selectedCity === 'all' || city === selectedCity;
    return matchesText && matchesCity;
  });

  const featuredStations = stations.filter(s => s.featured).slice(0, 3);
  const featuredProducts = products.filter(p => p.featured).slice(0, 4);
  const recentNews = news.slice(0, 3);
  const availableClassifieds = classifieds.filter(c => c.status === 'DISPONÍVEL').slice(0, 2);

  return (
    <div className="flex flex-col min-h-screen bg-slate-50 text-slate-900" id="rcm-home-view">
      {/* 1. IMPACTFUL HERO BLOCK WITH REAL PHOTOGRAPHY SLIDER */}
      <section className="relative min-h-[640px] lg:min-h-[720px] flex items-center justify-center overflow-hidden bg-slate-950 text-white">
        {/* Real Station Background Images Slider */}
        {heroSlides.map((slide, index) => (
          <div
            key={slide.id}
            className={`absolute inset-0 z-0 transition-opacity duration-1000 ease-in-out ${
              index === currentSlide ? 'opacity-100' : 'opacity-0 pointer-events-none'
            }`}
          >
            <img
              src={slide.photo}
              alt={slide.unitName}
              className="w-full h-full object-cover object-center transform scale-102 transition-transform duration-7000"
            />
            {/* Controlled blue institutional gradient overlay - guarantees legibility while preserving architecture and pumps */}
            <div className="absolute inset-0 bg-gradient-to-r from-blue-950/95 via-blue-950/82 to-slate-950/60" />
            <div className="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-blue-950/35 to-black/30" />
          </div>
        ))}

        {/* Slide Controls & Discrete Station Identification */}
        <div className="absolute top-24 right-4 sm:right-8 z-20 flex items-center gap-2">
          <div className="px-3.5 py-1.5 rounded-full bg-slate-900/80 backdrop-blur-md border border-white/20 text-white text-xs font-semibold flex items-center gap-2 shadow-lg">
            <span className="w-2 h-2 rounded-full bg-orange-500 animate-ping" />
            <span className="hidden sm:inline text-blue-200">Unidade Real:</span>
            <span className="font-bold text-white">{heroSlides[currentSlide].unitName}</span>
            <span className="text-orange-400 text-[11px] hidden md:inline font-medium">({heroSlides[currentSlide].tag})</span>
          </div>

          <div className="flex items-center gap-1 bg-slate-900/80 backdrop-blur-md rounded-full p-1 border border-white/20">
            <button
              type="button"
              onClick={() => setCurrentSlide(prev => (prev - 1 + heroSlides.length) % heroSlides.length)}
              className="p-1.5 rounded-full hover:bg-white/20 text-white transition-colors cursor-pointer"
              title="Slide anterior"
              aria-label="Slide anterior"
            >
              <ChevronLeft className="w-4 h-4" />
            </button>
            <button
              type="button"
              onClick={() => setCurrentSlide(prev => (prev + 1) % heroSlides.length)}
              className="p-1.5 rounded-full hover:bg-white/20 text-white transition-colors cursor-pointer"
              title="Próximo slide"
              aria-label="Próximo slide"
            >
              <ChevronRight className="w-4 h-4" />
            </button>
          </div>
        </div>

        {/* Slide Bullet Indicators at Bottom Left */}
        <div className="absolute bottom-6 left-4 sm:left-8 z-20 flex items-center gap-2">
          {heroSlides.map((slide, idx) => (
            <button
              key={slide.id}
              type="button"
              onClick={() => setCurrentSlide(idx)}
              className={`h-2 rounded-full transition-all cursor-pointer ${
                idx === currentSlide
                  ? 'w-8 bg-orange-500 shadow-md shadow-orange-500/50'
                  : 'w-2 bg-white/40 hover:bg-white/70'
              }`}
              title={`Ir para ${slide.unitName}`}
              aria-label={`Slide ${idx + 1}`}
            />
          ))}
          <span className="text-[11px] text-white/70 ml-2 font-mono hidden sm:inline">
            0{currentSlide + 1} / 0{heroSlides.length}
          </span>
        </div>

        {/* Hero Content Foreground */}
        <div className="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-28 w-full">
          <div className="max-w-3xl space-y-6 text-left">
            <div className="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-orange-400 text-xs font-bold uppercase tracking-wider">
              <span className="w-2 h-2 rounded-full bg-orange-500 animate-ping" />
              <span>Rede de Postos RCM • Padrão de Excelência & Expansão</span>
            </div>

            <h1 className="text-4xl sm:text-5xl lg:text-6xl font-display font-black tracking-tight text-white leading-tight">
              CONFIANÇA E QUALIDADE QUE{' '}
              <span className="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-300 to-orange-500">
                MOVEM SUA JORNADA
              </span>
            </h1>

            <p className="text-base sm:text-xl text-white font-normal max-w-2xl leading-relaxed drop-shadow-md">
              Bem-vindo à <strong>Rede de Postos RCM</strong>. Combustíveis 100% certificados com rigoroso controle de pureza, atendimento acolhedor, conveniência moderna e infraestrutura completa para você e sua frota.
            </p>

            {/* Strategic CTAs */}
            <div className="pt-4 flex flex-wrap items-center gap-3.5">
              <button
                type="button"
                onClick={() => {
                  const el = document.getElementById('rcm-perto-de-voce');
                  el?.scrollIntoView({ behavior: 'smooth' });
                }}
                className="flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold text-sm sm:text-base shadow-xl shadow-orange-500/30 transition-all hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
              >
                <MapPin className="w-5 h-5" />
                <span>ENCONTRE UMA RCM</span>
              </button>

              <button
                type="button"
                onClick={() => setActiveTab('unidades')}
                className="flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm sm:text-base backdrop-blur-md border border-white/25 transition-all cursor-pointer"
              >
                <Fuel className="w-5 h-5 text-blue-300" />
                <span>CONHEÇA NOSSAS UNIDADES</span>
              </button>

              <button
                type="button"
                onClick={() => setActiveTab('servicos')}
                className="flex items-center justify-center gap-2 px-5 py-4 rounded-xl bg-blue-900/60 hover:bg-blue-800 text-blue-200 font-semibold text-sm transition-all border border-blue-700/50 cursor-pointer"
              >
                <Wrench className="w-4 h-4 text-orange-400" />
                <span>NOSSOS SERVIÇOS</span>
              </button>

              <a
                href="https://wa.me/5584998765432"
                target="_blank"
                rel="noopener noreferrer"
                className="flex items-center justify-center gap-2 px-5 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-lg shadow-emerald-600/30 transition-all"
              >
                <MessageCircle className="w-4 h-4" />
                <span>FALE PELO WHATSAPP</span>
              </a>
            </div>

            {/* Quality Badges */}
            <div className="pt-6 border-t border-white/15 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-medium text-slate-300">
              <div className="flex items-center gap-2">
                <ShieldCheck className="w-5 h-5 text-orange-400 shrink-0" />
                <span>Teste de Proveta Gratuito na Pista</span>
              </div>
              <div className="flex items-center gap-2">
                <Clock className="w-5 h-5 text-orange-400 shrink-0" />
                <span>Atendimento 24 Horas</span>
              </div>
              <div className="flex items-center gap-2">
                <Award className="w-5 h-5 text-orange-400 shrink-0" />
                <span>Frota & Logística Própria</span>
              </div>
            </div>
          </div>
        </div>

        {/* TRANSPARENT MASCOT INTEGRATED IN BOTTOM-RIGHT CORNER AS MICRO-INTERACTION */}
        <div className="absolute bottom-0 right-3 sm:right-6 lg:right-10 z-20 flex flex-col items-end pointer-events-none select-none">
          {/* Temporary Welcome Balloon */}
          {mascotBubbleVisible && (
            <div className="pointer-events-auto mb-2 mr-3 sm:mr-6 bg-white/95 backdrop-blur-md text-slate-800 rounded-2xl rounded-br-none p-3.5 shadow-2xl border border-blue-200/80 max-w-[240px] text-xs transition-all animate-fade-in relative">
              <button
                type="button"
                onClick={() => setMascotBubbleVisible(false)}
                className="absolute top-1.5 right-1.5 text-slate-400 hover:text-slate-600 p-0.5 rounded-full"
                title="Fechar mensagem"
                aria-label="Fechar mensagem"
              >
                <X className="w-3.5 h-3.5" />
              </button>
              <div className="flex items-center gap-1 text-[10px] font-bold text-orange-600 uppercase tracking-wider mb-1">
                <Sparkles className="w-3 h-3" />
                Mascote Oficial RCM
              </div>
              <p className="leading-snug text-slate-700">
                Olá! Bem-vindo à <strong>Rede RCM</strong>. Nossas unidades reais contam com combustível certificado e atendimento acolhedor!
              </p>
            </div>
          )}

          {/* Clean Transparent Mascot PNG */}
          <div
            className="pointer-events-auto cursor-pointer group"
            onClick={() => setMascotBubbleVisible(prev => !prev)}
            title="Clique para interagir com o Mascote RCM"
          >
            <img
              src="/assets/Mascote RCM.png"
              onError={(e) => {
                const target = e.currentTarget;
                if (target.src !== '/assets/rcm_mascot.png') target.src = '/assets/rcm_mascot.png';
              }}
              alt="Mascote Oficial Rede de Postos RCM"
              className="h-[420px] sm:h-[480px] md:h-[540px] lg:h-[600px] w-auto max-w-none object-contain object-bottom transition-transform duration-300 group-hover:scale-105 drop-shadow-[0_12px_24px_rgba(0,0,0,0.65)]"
            />
          </div>
        </div>
      </section>

      {/* 2. INSTITUTIONAL SUMMARY STRIP */}
      <section className="bg-blue-900 text-white py-6 border-y border-blue-950">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="grid grid-cols-2 md:grid-cols-4 gap-6 text-center divide-x divide-blue-800/80">
            <div className="px-3">
              <p className="text-2xl sm:text-3xl font-display font-black text-orange-400">100%</p>
              <p className="text-xs uppercase tracking-wider text-blue-200 mt-0.5">Combustível Certificado</p>
            </div>
            <div className="px-3">
              <p className="text-2xl sm:text-3xl font-display font-black text-white">24 Horas</p>
              <p className="text-xs uppercase tracking-wider text-blue-200 mt-0.5">Atendimento em Rodovias</p>
            </div>
            <div className="px-3">
              <p className="text-2xl sm:text-3xl font-display font-black text-orange-400">+28 Carretas</p>
              <p className="text-xs uppercase tracking-wider text-blue-200 mt-0.5">Transportadora Dedicada</p>
            </div>
            <div className="px-3">
              <p className="text-2xl sm:text-3xl font-display font-black text-white">Frotas & Varejo</p>
              <p className="text-xs uppercase tracking-wider text-blue-200 mt-0.5">Soluções Corporativas</p>
            </div>
          </div>
        </div>
      </section>

      {/* 3. SECTION: RCM PERTO DE VOCÊ (Search, Highlights & Interactive Map) */}
      <section id="rcm-perto-de-voce" className="py-14 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        <div className="text-center max-w-3xl mx-auto mb-8">
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-100 text-orange-700 text-xs font-bold uppercase tracking-wider mb-3">
            <MapPin className="w-3.5 h-3.5 text-orange-600" />
            <span>Localização RCM</span>
          </div>
          <h2 className="text-3xl sm:text-4xl font-display font-bold text-slate-900 tracking-tight">
            RCM PERTO DE VOCÊ
          </h2>
          <p className="text-slate-600 text-sm sm:text-base mt-2">
            Pesquise por cidade, estado, nome da unidade ou encontre o posto RCM mais próximo com traçado automático de rota.
          </p>
        </div>

        {/* Search & Filter Bar */}
        <div className="bg-white rounded-2xl p-4 sm:p-5 shadow-lg border border-slate-200/80 mb-8 max-w-4xl mx-auto">
          <div className="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
            {/* Input search */}
            <div className="md:col-span-7 relative">
              <Search className="w-5 h-5 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
              <input
                type="text"
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
                placeholder="Buscar por nome da unidade, endereço ou bairro..."
                className="w-full pl-11 pr-4 py-3 rounded-xl bg-slate-50 border border-slate-200 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-900 text-sm text-slate-800"
              />
            </div>

            {/* City Dropdown */}
            <div className="md:col-span-5 flex gap-2">
              <select
                value={selectedCity}
                onChange={(e) => setSelectedCity(e.target.value)}
                className="w-full py-3 px-3.5 rounded-xl bg-slate-50 border border-slate-200 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-900 text-sm text-slate-700 font-medium"
              >
                <option value="all">Todas as Cidades</option>
                {cities.map(c => (
                  <option key={c} value={c}>{c}</option>
                ))}
              </select>

              <button
                type="button"
                onClick={() => setActiveTab('unidades')}
                className="px-4 py-3 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs uppercase tracking-wider shrink-0 transition-colors cursor-pointer"
              >
                Ver Todas
              </button>
            </div>
          </div>
        </div>

        {/* Featured Units Grid */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {filteredStations.slice(0, 3).map(station => (
            <StationCard
              key={station.id}
              station={station}
              onViewUnit={onSelectUnit}
            />
          ))}
        </div>

        {/* Visual Map of RCM Presence */}
        <div className="space-y-3">
          <div className="flex items-center justify-between">
            <h3 className="text-lg font-display font-bold text-slate-900 flex items-center gap-2">
              <Navigation className="w-5 h-5 text-orange-500" />
              <span>Mapa da Rede RCM</span>
            </h3>
            <button
              type="button"
              onClick={() => setActiveTab('unidades')}
              className="text-xs font-bold text-blue-900 hover:text-orange-600 flex items-center gap-1 cursor-pointer"
            >
              <span>Ver no modo tela cheia</span>
              <ChevronRight className="w-3.5 h-3.5" />
            </button>
          </div>

          <GoogleMapEmbed
            stations={stations}
            onSelectStation={onSelectUnit}
          />
        </div>
      </section>

      {/* 4. QUEM SOMOS (Resumo com link) */}
      <section className="py-20 bg-white border-y border-slate-200/80">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div className="lg:col-span-6 relative">
              <div className="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
                <img
                  src="/assets/rcm-alcantil.jpeg"
                  alt="Estrutura Posto RCM"
                  className="w-full h-96 sm:h-[450px] object-cover"
                />
                <div className="absolute inset-0 bg-gradient-to-t from-blue-950/80 via-transparent to-transparent" />
                <div className="absolute bottom-6 left-6 right-6 text-white">
                  <span className="text-xs font-bold uppercase tracking-wider text-orange-400">
                    Nossa Essência
                  </span>
                  <p className="text-xl font-display font-bold mt-1">
                    Excelência na Pista e Respeito a Cada Cliente
                  </p>
                </div>
              </div>

              {/* Floating detail tag */}
              <div className="absolute -bottom-6 -right-4 bg-orange-500 text-white p-5 rounded-2xl shadow-xl hidden sm:block">
                <p className="text-2xl font-black font-display">+14 Anos</p>
                <p className="text-xs font-semibold">de Tradição & Inovação</p>
              </div>
            </div>

            <div className="lg:col-span-6 space-y-6">
              <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-900 text-xs font-bold uppercase tracking-wider">
                <span>Institucional</span>
              </div>

              <h2 className="text-3xl sm:text-4xl font-display font-bold text-slate-900 tracking-tight leading-tight">
                UMA HISTÓRIA DE CONFIANÇA, PESSOAS E CRESCIMENTO
              </h2>

              <p className="text-slate-600 text-base leading-relaxed">
                A <strong>Rede de Postos RCM</strong> nasceu com um compromisso claro: entregar combustível com padrão inquestionável de qualidade e um atendimento próximo e respeitoso. Ao longo dos anos, expandimos nossa presença com modernização contínua de unidades, investimento em pessoas e frota logística própria.
              </p>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
                  <h4 className="font-bold text-blue-900 text-sm mb-1 flex items-center gap-2">
                    <CheckCircle2 className="w-4 h-4 text-orange-500" />
                    <span>Missão Clara</span>
                  </h4>
                  <p className="text-xs text-slate-600">
                    Fornecer energia, conveniência e tranquilidade a motoristas, famílias e frotistas com credibilidade absoluta.
                  </p>
                </div>

                <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
                  <h4 className="font-bold text-blue-900 text-sm mb-1 flex items-center gap-2">
                    <CheckCircle2 className="w-4 h-4 text-orange-500" />
                    <span>Visão de Futuro</span>
                  </h4>
                  <p className="text-xs text-slate-600">
                    Ser a rede de postos mais reconhecida e confiável da nossa região, integrando tecnologia e proximidade humana.
                  </p>
                </div>
              </div>

              <div className="pt-2">
                <button
                  type="button"
                  onClick={() => setActiveTab('quem-somos')}
                  className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-sm shadow-md transition-all hover:gap-3 cursor-pointer"
                >
                  <span>Conheça Nossa História Completa</span>
                  <ArrowRight className="w-4 h-4" />
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 5. PRODUTOS EM DESTAQUE (Vitrine) */}
      <section className="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        <div className="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
          <div>
            <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-100 text-orange-700 text-xs font-bold uppercase tracking-wider mb-2">
              <Sparkles className="w-3.5 h-3.5 text-orange-600" />
              <span>Catálogo Automotivo</span>
            </div>
            <h2 className="text-3xl sm:text-4xl font-display font-bold text-slate-900">
              PRODUTOS COM A QUALIDADE RCM
            </h2>
            <p className="text-slate-600 text-sm sm:text-base mt-1">
              Lubrificantes homologados, fluidos e aditivos de alta performance para a máxima vida útil do seu motor.
            </p>
          </div>

          <button
            type="button"
            onClick={() => setActiveTab('produtos')}
            className="inline-flex items-center gap-2 text-sm font-bold text-blue-900 hover:text-orange-600 cursor-pointer self-start md:self-auto"
          >
            <span>Ver Todo o Catálogo</span>
            <ChevronRight className="w-4 h-4" />
          </button>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredProducts.map(prod => (
            <div
              key={prod.id}
              className="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-xs hover:shadow-lg transition-all p-5 flex flex-col justify-between"
            >
              <div>
                <div className="h-44 rounded-xl overflow-hidden bg-slate-100 mb-4">
                  <img
                    src={prod.photo}
                    alt={prod.name}
                    className="w-full h-full object-cover hover:scale-105 transition-transform"
                  />
                </div>
                <span className="text-[11px] font-bold text-orange-600 uppercase tracking-wider">
                  {prod.brand}
                </span>
                <h3 className="text-base font-bold text-slate-900 mt-0.5 line-clamp-2">
                  {prod.name}
                </h3>
                <p className="text-xs text-slate-500 mt-2 line-clamp-2">
                  {prod.description}
                </p>
              </div>

              <div className="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
                <span className="text-xs font-semibold text-slate-600">Volume: {prod.volume}</span>
                <a
                  href={`https://wa.me/5584998765432?text=${encodeURIComponent(
                    `Olá! Vi este produto no site da Rede RCM e gostaria de mais informações sobre: ${prod.name}`
                  )}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="px-3 py-1.5 rounded-lg bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs shadow-xs transition-colors"
                >
                  Tenho Interesse
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* 6. SERVIÇOS (Apresentação dos principais serviços) */}
      <section className="py-20 bg-slate-900 text-white">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="text-center max-w-3xl mx-auto mb-16">
            <span className="text-xs font-bold uppercase tracking-wider text-orange-400 bg-orange-500/20 px-3 py-1 rounded-full border border-orange-500/30">
              Estrutura & Conforto
            </span>
            <h2 className="text-3xl sm:text-4xl font-display font-bold text-white mt-3">
              SERVIÇOS DE EXCELÊNCIA EM NOSSAS PISTAS
            </h2>
            <p className="text-slate-300 text-sm sm:text-base mt-2">
              Cada unidade foi projetada para resolver a sua necessidade com rapidez, segurança e o carinho do atendimento RCM.
            </p>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-8">
            {services.slice(0, 6).map(srv => (
              <div
                key={srv.id}
                className="bg-slate-800/80 rounded-2xl p-6 border border-slate-700 hover:border-orange-500/60 transition-all group flex flex-col justify-between"
              >
                <div>
                  <div className="w-12 h-12 rounded-xl bg-orange-500/20 text-orange-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <Wrench className="w-6 h-6" />
                  </div>
                  <h3 className="text-lg font-display font-bold text-white mb-2">
                    {srv.name}
                  </h3>
                  <p className="text-xs sm:text-sm text-slate-300 leading-relaxed mb-4">
                    {srv.shortDescription}
                  </p>
                </div>

                <button
                  type="button"
                  onClick={() => setActiveTab('unidades')}
                  className="text-xs font-bold text-orange-400 hover:text-orange-300 flex items-center gap-1 pt-3 border-t border-slate-700/60 cursor-pointer"
                >
                  <span>Encontre Unidade com este Serviço</span>
                  <ChevronRight className="w-3.5 h-3.5" />
                </button>
              </div>
            ))}
          </div>

          <div className="mt-12 text-center">
            <button
              type="button"
              onClick={() => setActiveTab('servicos')}
              className="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm shadow-lg shadow-orange-500/25 transition-all cursor-pointer"
            >
              <span>Ver Todos os Serviços da Rede</span>
              <ChevronRight className="w-4 h-4" />
            </button>
          </div>
        </div>
      </section>

      {/* 7. RCM NEWS (Notícias mais recentes) */}
      <section className="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        <div className="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
          <div>
            <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-900 text-xs font-bold uppercase tracking-wider mb-2">
              <span>Portal Informativo</span>
            </div>
            <h2 className="text-3xl sm:text-4xl font-display font-bold text-slate-900">
              RCM NEWS
            </h2>
            <p className="text-slate-600 text-sm sm:text-base mt-1">
              Fique por dentro das novidades, expansões, ações sociais e dicas da nossa rede.
            </p>
          </div>

          <button
            type="button"
            onClick={() => setActiveTab('rcm-news')}
            className="inline-flex items-center gap-2 text-sm font-bold text-blue-900 hover:text-orange-600 cursor-pointer"
          >
            <span>Acessar Todas as Notícias</span>
            <ChevronRight className="w-4 h-4" />
          </button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          {recentNews.map(item => (
            <div
              key={item.id}
              onClick={() => onSelectNews(item)}
              className="group bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-xs hover:shadow-lg transition-all cursor-pointer flex flex-col justify-between"
            >
              <div>
                <div className="h-48 overflow-hidden bg-slate-100 relative">
                  <img
                    src={item.coverImage}
                    alt={item.title}
                    className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                  <span className="absolute top-3 left-3 px-3 py-1 rounded-full bg-blue-900 text-white text-xs font-bold shadow-md">
                    {item.category}
                  </span>
                </div>
                <div className="p-5">
                  <span className="text-[11px] text-slate-400 block mb-2">{item.date} • {item.readTime}</span>
                  <h3 className="text-base font-bold text-slate-900 group-hover:text-blue-900 transition-colors line-clamp-2">
                    {item.title}
                  </h3>
                  <p className="text-xs text-slate-600 mt-2 line-clamp-3 leading-relaxed">
                    {item.summary}
                  </p>
                </div>
              </div>

              <div className="p-5 pt-0">
                <span className="text-xs font-bold text-orange-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                  <span>Ler Notícia Completa</span>
                  <ChevronRight className="w-3.5 h-3.5" />
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* 8. AÇÕES RCM & TRANSPORTADORA (Combined Highlight Row) */}
      <section className="py-20 bg-slate-100 border-y border-slate-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {/* Ações RCM Card */}
            <div className="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm flex flex-col justify-between">
              <div>
                <div className="flex items-center justify-between mb-4">
                  <span className="text-xs font-bold uppercase tracking-wider text-orange-600 bg-orange-50 px-3 py-1 rounded-full">
                    Gente & Comunidade
                  </span>
                  <span className="text-xs text-slate-400">Trilhas & Treinamentos</span>
                </div>
                <h3 className="text-2xl font-display font-bold text-slate-900 mb-3">
                  AÇÕES & PROJETOS SOCIAIS RCM
                </h3>
                <p className="text-slate-600 text-sm leading-relaxed mb-6">
                  Mais do que postos de combustível, a RCM é uma comunidade engajada no desenvolvimento de seus colaboradores, segurança operacional e acolhimento das famílias locais.
                </p>

                {actions[0] && (
                  <div className="rounded-2xl overflow-hidden relative mb-6">
                    <img
                      src={actions[0].coverImage}
                      alt={actions[0].title}
                      className="w-full h-48 object-cover"
                    />
                    <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-4 text-white">
                      <p className="text-sm font-bold">{actions[0].title}</p>
                    </div>
                  </div>
                )}
              </div>

              <button
                type="button"
                onClick={() => setActiveTab('acoes')}
                className="w-full py-3 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-colors cursor-pointer"
              >
                <span>Ver Todas as Ações RCM</span>
                <ChevronRight className="w-4 h-4" />
              </button>
            </div>

            {/* Nossa Transportadora Card */}
            <div className="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm flex flex-col justify-between">
              <div>
                <div className="flex items-center justify-between mb-4">
                  <span className="text-xs font-bold uppercase tracking-wider text-blue-900 bg-blue-50 px-3 py-1 rounded-full">
                    Logística Própria
                  </span>
                  <span className="text-xs text-slate-400">Autonomia & Segurança</span>
                </div>
                <h3 className="text-2xl font-display font-bold text-slate-900 mb-3">
                  NOSSA TRANSPORTADORA DEDICADA
                </h3>
                <p className="text-slate-600 text-sm leading-relaxed mb-6">
                  Frota própria com caminhões-tanque rastreados via satélite 24 horas por dia, lacres eletrônicos e condutores certificados MOPE. O combustível chega com pureza intacta.
                </p>

                <div className="rounded-2xl overflow-hidden relative mb-6">
                  <img
                    src="/assets/logistica-rcm.jpg"
                    alt="Frota Transportadora RCM"
                    className="w-full h-48 object-cover"
                  />
                  <div className="absolute bottom-3 left-3 right-3 bg-blue-950/80 backdrop-blur-md rounded-xl p-3 text-white flex items-center justify-between text-xs">
                    <span>Frota Ativa: <strong>{transporter.fleetCount} carretas</strong></span>
                    <span className="text-orange-400 font-bold">Pontualidade: {transporter.punctualityRate}</span>
                  </div>
                </div>
              </div>

              <button
                type="button"
                onClick={() => setActiveTab('transportadora')}
                className="w-full py-3 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-colors cursor-pointer"
              >
                <span>Conheça a Operação de Transporte</span>
                <ChevronRight className="w-4 h-4" />
              </button>
            </div>
          </div>
        </div>
      </section>

      {/* 9. CLASSIFICADOS RCM (Espaços Comerciais) */}
      <section className="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        <div className="bg-gradient-to-r from-blue-950 via-blue-900 to-indigo-950 rounded-3xl p-8 sm:p-12 text-white shadow-2xl relative overflow-hidden">
          <div className="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div className="lg:col-span-7 space-y-4">
              <span className="inline-block px-3 py-1 rounded-full bg-orange-500/20 text-orange-400 font-bold text-xs uppercase tracking-wider border border-orange-500/30">
                Oportunidades de Negócio
              </span>
              <h2 className="text-3xl sm:text-4xl font-display font-bold text-white tracking-tight">
                CLASSIFICADOS RCM: ESPAÇOS PARA LOCAÇÃO
              </h2>
              <p className="text-blue-100/80 text-sm sm:text-base leading-relaxed max-w-xl">
                Traga sua loja de conveniência, farmácia, lanchonete ou estética automotiva para os pontos mais movimentados da região, com fluxo constante de milhares de motoristas.
              </p>

              <div className="pt-2 flex flex-wrap items-center gap-3">
                <button
                  type="button"
                  onClick={() => setActiveTab('classificados')}
                  className="px-6 py-3.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm shadow-lg shadow-orange-500/30 transition-all cursor-pointer"
                >
                  Ver Espaços Comerciais Disponíveis
                </button>
                <a
                  href="https://wa.me/5584998765432?text=Ol%C3%A1!%20Gostaria%20de%20informa%C3%A7%C3%B5es%20sobre%20espa%C3%A7os%20comerciais%20para%20loca%C3%A7%C3%A3o%20na%20Rede%20RCM."
                  target="_blank"
                  rel="noopener noreferrer"
                  className="px-5 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm border border-white/20 transition-colors"
                >
                  Falar com Setor de Expansão
                </a>
              </div>
            </div>

            <div className="lg:col-span-5">
              <RcmMascot
                context="classificados"
                position="card"
                onCtaClick={() => setActiveTab('classificados')}
              />
            </div>
          </div>
        </div>
      </section>

      {/* 10. FINAL STRONG CTA: PRECISA FALAR COM A RCM? */}
      <section className="py-16 bg-gradient-to-br from-orange-500 via-orange-600 to-amber-600 text-white text-center relative overflow-hidden">
        <div className="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 space-y-5">
          <div className="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white/20 backdrop-blur-md text-white mb-2">
            <MessageCircle className="w-8 h-8" />
          </div>

          <h2 className="text-3xl sm:text-5xl font-display font-black tracking-tight text-white">
            PRECISA FALAR COM A RCM?
          </h2>

          <p className="text-orange-100 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed font-normal">
            Estamos prontos para tirar dúvidas, fechar parcerias para frotas corporativas, atender fornecedores ou ouvir sua sugestão. Fale diretamente com a nossa equipe.
          </p>

          <div className="pt-3 flex flex-wrap justify-center items-center gap-4">
            <a
              href="https://wa.me/5584998765432?text=Ol%C3%A1!%20Estou%20no%20site%20da%20Rede%20RCM%20e%20gostaria%20de%20atendimento."
              target="_blank"
              rel="noopener noreferrer"
              className="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-white text-orange-600 hover:bg-slate-100 font-extrabold text-base shadow-2xl transition-all transform hover:scale-105 active:scale-95"
            >
              <MessageCircle className="w-6 h-6 text-emerald-600 fill-emerald-600/20" />
              <span>FALAR PELO WHATSAPP AGORA</span>
            </a>

            <button
              type="button"
              onClick={() => setActiveTab('contato')}
              className="inline-flex items-center gap-2 px-6 py-4 rounded-2xl bg-orange-700/60 hover:bg-orange-700 text-white font-bold text-base border border-orange-400/40 transition-colors cursor-pointer"
            >
              <span>Outros Canais de Contato</span>
            </button>
          </div>
        </div>
      </section>
    </div>
  );
};
